/*
 * Constellations - Text Crawl transition.
 *
 * The canvas is cut into rows, and a ticker bar carrying a repeated phrase
 * slides along each one, rows staggered: the outgoing scene is ahead of the
 * bar and the incoming one behind it. Every row's bar starts just off the
 * canvas and ends just past it, so the first and last frames are the two
 * scenes exactly.
 *
 * As Text Cover (hold >= 0) each bar is a whole line: it slides in until the
 * rows cover the canvas, holds while the scenes swap underneath, then slides
 * on out the far side.
 */

uniform float4x4 ViewProj;
uniform texture2d a_tex;
uniform texture2d b_tex;
uniform texture2d text_sdf;    /* R16: 0.5 - distance / (2 * spread) */
uniform texture2d sep_sdf;

uniform float2 canvas;
uniform float progress;
uniform float easing;          /* 0 linear, 1 in and out, 2 out */
uniform float rows;
uniform float bar_w;           /* px */
uniform float stagger;         /* share of the transition the last row waits */
uniform float hold;            /* < 0 crawl; else share of the transition held covered */
uniform float direction;       /* 0 left to right, 1 right to left, 2 alternate */
uniform float has_text;
uniform float2 text_size;      /* phrase layout box, layout px */
uniform float4 text_rect;      /* the field's x, y, width, height in that box */
uniform float has_sep;
uniform float2 sep_size;       /* separator layout box, layout px */
uniform float4 sep_rect;
uniform float sep_x;           /* where the separator's box starts in the period */
uniform float period;          /* layout px from one phrase to the next */
uniform float text_scale;      /* canvas px per layout px */
uniform float sdf_spread;
uniform float offset_mode;     /* 0 random, 1 stagger, 2 none */
uniform float offset;          /* stagger: share of a period each row shifts */
uniform float seed;
uniform float drift;           /* px the text moves along its bar over the transition */
uniform float drift_var;       /* 0..1, how much each row's drift differs */
uniform float4 bar_color;
uniform float4 text_color;

sampler_state textureSampler {
	Filter   = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData v_out;
	v_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	v_out.uv  = v_in.uv;
	return v_out;
}

float ease(float t)
{
	if (easing > 1.5)
		return 1.0 - (1.0 - t) * (1.0 - t);
	if (easing > 0.5)
		return t * t * (3.0 - 2.0 * t);
	return t;
}

float row_hash(float row, float salt)
{
	return frac(sin(dot(float2(row, seed + salt), float2(12.9898, 78.233))) * 43758.5453);
}

float sd_cover(float v)
{
	return saturate(0.5 - (0.5 - v) * 2.0 * sdf_spread * text_scale);
}

bool outside(float2 uv)
{
	return uv.x < 0.0 || uv.y < 0.0 || uv.x > 1.0 || uv.y > 1.0;
}

/* Coverage of the phrase or the separator at p, in layout px. One function
 * per texture: OBS's GLSL translation only samples a texture named directly. */
float text_cover(float2 p)
{
	float2 uv = (p - text_rect.xy) / text_rect.zw;
	return outside(uv) ? 0.0 : sd_cover(text_sdf.SampleLevel(textureSampler, uv, 0.0).r);
}

float sep_cover(float2 p)
{
	float2 uv = (p - float2(sep_x, 0.5 * (text_size.y - sep_size.y)) - sep_rect.xy) / sep_rect.zw;
	return has_sep < 0.5 || outside(uv) ? 0.0 : sd_cover(sep_sdf.SampleLevel(textureSampler, uv, 0.0).r);
}

float4 PSCrawl(VertData v_in) : TARGET
{
	float2 px = v_in.uv * canvas;
	float row_h = canvas.y / rows;
	float row = min(floor(px.y / row_h), rows - 1.0);
	bool back = direction > 1.5 ? fmod(row, 2.0) > 0.5 : direction > 0.5;
	float x = back ? canvas.x - px.x : px.x;

	float delay = rows > 1.0 ? stagger * row / (rows - 1.0) : 0.0;
	float span = max(1.0 - stagger, 0.0001);
	float lead;
	if (hold < 0.0) {
		lead = ease(saturate((progress - delay) / span)) * (canvas.x + bar_w);
	} else {
		/* in over the first part, out over the last, each with its own stagger */
		float ph = max(0.5 * (1.0 - hold), 0.0001);
		float p_in = saturate((progress / ph - delay) / span);
		float p_out = saturate(((progress - 1.0 + ph) / ph - delay) / span);
		lead = (ease(p_in) + ease(p_out)) * canvas.x;
	}

	float4 a = a_tex.SampleLevel(textureSampler, v_in.uv, 0.0);
	float4 b = b_tex.SampleLevel(textureSampler, v_in.uv, 0.0);
	float4 bar = bar_color;
	if (has_text > 0.5) {
		/* the phrase rides on the bar, each row set off by the row offset and
		 * drifting along it at its own pace */
		float shift = offset_mode < 0.5 ? row_hash(row, 0.0) : (offset_mode < 1.5 ? frac(row * offset) : 0.0);
		float d = drift * progress * (1.0 + drift_var * (2.0 * row_hash(row, 7.0) - 1.0));
		float gx = ((back ? lead - x : x - lead) - (back ? -d : d)) / text_scale + shift * period;
		float2 g = float2(gx - floor(gx / period) * period,
				  (px.y - (row + 0.5) * row_h) / text_scale + 0.5 * text_size.y);
		bar = lerp(bar, text_color, max(text_cover(g), sep_cover(g)));
	}

	float4 c = lerp(a, bar, saturate(lead - x + 0.5));
	return lerp(c, b, saturate(lead - bar_w - x + 0.5));
}

technique Crawl
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSCrawl(v_in);
	}
}
