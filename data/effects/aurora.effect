// Constellations - Aurora / Mesh Gradient
// (c) 2026 Eion Dailey - GPLv2+
//
// Mesh Gradient: the five colors are points wandering on slow Lissajous
// paths, blended by inverse distance through a noise-warped canvas, the soft
// "mesh gradient" look. Aurora: three curtains of light hang over the
// background, each a wavy baseline with vertical rays rising off it and
// fading upwards, shading from one palette color into the next.

#include "gen_common.effect"

uniform float mode;      // 0 mesh gradient, 1 aurora
uniform float scale;
uniform float sharpness; // how hard the mesh colors meet
uniform float warp;
uniform float height;    // aurora baseline, share of the canvas height from the top
uniform float intensity;
uniform float grain;
uniform float opacity;

float2 mesh_point(float i, float2 ext)
{
	float2 w = float2(sin(time * (0.21 + 0.07 * i) + i * 1.7), cos(time * (0.17 + 0.05 * i) + i * 2.9));
	return ext * (0.5 + 0.42 * w);
}

float3 mesh(float2 p, float2 ext)
{
	float3 sum = float3(0.0, 0.0, 0.0);
	float total = 0.0;
	float s = max(scale, 0.05) * 0.35;
	for (float i = 0.0; i < 5.0; i += 1.0) {
		float2 d = (p - mesh_point(i, ext)) / s;
		float w = 1.0 / pow(dot(d, d) + 0.002, max(sharpness, 0.1) * 0.5);
		sum += palette_pick(i) * w;
		total += w;
	}
	return sum / total;
}

float3 aurora(float2 uv, float aspect)
{
	float3 acc = float3(0.0, 0.0, 0.0);
	float x = uv.x * aspect / max(scale, 0.05);
	for (float j = 0.0; j < 3.0; j += 1.0) {
		float base = height + (fbm(float2(x * 1.3 + j * 3.1, time * 0.12 + j * 1.7)) - 0.5) * 0.35 * warp - j * 0.06;
		float dy = base - uv.y;
		float rays = 0.45 + 0.55 * vnoise(float2(x * 40.0 + j * 11.0, time * 0.6 + j));
		float shape = dy > 0.0 ? exp(-dy / (0.18 + 0.08 * j)) * rays : exp(dy * 60.0);
		float3 c = lerp(palette_pick(j), palette_pick(j + 1.0), saturate(dy * 2.5));
		acc += c * shape * (0.7 - 0.15 * j);
	}
	return acc * intensity;
}

float4 PSAurora(VertData v_in) : TARGET
{
	float2 uv = v_in.uv;
	float m = max(canvas_size.x, canvas_size.y);
	float2 ext = canvas_size / m;
	float2 p = uv * ext;
	float n = (hash21(floor(uv * canvas_size) + frac(clock) * 61.0) - 0.5) * grain * 0.06;

	if (mode < 0.5) {
		p += warp * 0.12 * (float2(fbm(p * 2.0 + time * 0.07), fbm(p * 2.0 + 5.2 - time * 0.07)) - 0.5);
		return over_bg(saturate(mesh(p, ext) + n), saturate(opacity));
	}

	float3 light = max(aurora(uv, ext.x / ext.y) + n, 0.0) * saturate(opacity);
	float a = saturate(max(bg_color.a, max(light.r, max(light.g, light.b))));
	return float4(bg_color.rgb * bg_color.a + light, a);
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSAurora(v_in);
	}
}
