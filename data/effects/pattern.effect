// Constellations - Pattern effect
// (c) 2026 Eion Dailey - GPLv2+
//
// Every shape is its own quad. Draws pass no vertex buffer: the vertex
// shader turns the vertex id into an instance (a lattice cell, or a place on
// a Pattern Border row), computes that instance's position, rotation, color
// and twinkle, and emits a quad around it. The pixel shader evaluates just
// that one shape, so cost follows the area the shapes cover and any shape
// size works at any density.
//
// Output is linear-light, premultiplied color; the renderer enables the sRGB
// framebuffer and premultiplied blending around every draw. Colors arrive in
// linear light except the background gradient's, which are blended in sRGB
// (the way a gradient tool draws them) and converted here.
//
// Scrolling arrives pre-split into wrapped whole cells and px remainders
// (see src/lattice.c, which mirrors the arithmetic below and is unit
// tested), so nothing here grows with time.

uniform float4x4 ViewProj;
uniform float2 canvas_size;

// Lattice placement
uniform float2 origin;          // anchor + item offset, px
uniform float2 lattice_dir;     // row direction (cos, sin of canvas rotation)
uniform float cell_size;
uniform float row_first;        // first row drawn, relative to the scroll
uniform float col_count;        // instances drawn per row
uniform float along_min;        // start of the visible along-row span, px
uniform float row_wrap;         // whole rows scrolled, mod 4096
uniform float perp_frac;        // rest of the cross-row scroll, px
uniform float col_cells;        // whole cells scrolled along rows, mod 64 * col_period
uniform float col_frac;         // rest of the along-row scroll, px
uniform float col_period;       // columns repeat after this many cells
uniform float alt_lines;        // 1 = odd rows run backwards
uniform float brick;            // 1 = odd rows sit half a cell along
uniform float drift_speed_amt;  // per-row speed variation
uniform float drift_speed_seed;

// Pattern Border perimeter placement: one draw per row
uniform float border_mode;      // 1 = instances follow the row below
uniform float4 row_box;         // x0, y0, x1, y1
uniform float4 row_rad;         // corner radii tl, tr, br, bl
uniform float4 row_ns;          // shapes on the top, right, bottom, left sides
uniform float4 row_na;          // shapes on the tr, br, bl, tl corners
uniform float row_total;
uniform float row_index;
uniform float row_phase;        // shapes marched along the row, [0, total)
uniform float border_align;     // 1 = shapes turn to follow the frame
uniform float offset_inward;    // px toward the inside of the frame
uniform float ring_mode;        // 1 = one continuous line along the row path

// Per-instance animation
uniform float item_seed;
uniform float wander_amt;       // Location Drift, fraction of a cell
uniform float wander_time;      // radians, wrapped at 64 * 2 pi
uniform float twinkle_amount;   // fraction of instances that twinkle
uniform float twinkle_phase;    // cycles, wrapped at 64
uniform float auto_rot_active;
uniform float auto_rot_phase;   // radians of unison spin
uniform float auto_rot_seed;

// Layout: which item owns a cell
uniform float layout_mode;      // 0 layered, 1 step-repeat, 2 grid
uniform float grid_random;
uniform float step_index;
uniform float step_count;

// Shape
uniform float shape_kind;
uniform float polygon_sides;
uniform float stroke_thickness;
uniform float outline_only;
uniform float shape_size;
uniform float shape_rotation;   // radians
uniform float2 quad_half;       // quad half extents in the shape's frame
uniform float line_axis;        // 1 = horizontal line, 2 = vertical line
uniform float4 shape_color;     // linear rgb (shape color or tint), a = opacity
uniform float color_variation;
uniform float4 color_b;
uniform float4 color_c;
uniform float image_color_mode; // 0 original, 1 tint, 2 recolor

// Masks
uniform float vignette_enabled;
uniform float2 vignette_center;
uniform float vignette_size_px;
uniform float vignette_direction;
uniform float vignette_shape;
uniform float vignette_polygon_sides;
uniform float vignette_softness;
uniform float vignette_inverted;

uniform float border_active;
uniform float border_clip;
uniform float4 border_widths;      // left, top, right, bottom
uniform float border_radius;
uniform float4 border_inner_radii; // tl, tr, br, bl
uniform float border_softness;

// Background (sRGB-encoded, straight alpha)
uniform float4 bg_color;
uniform float4 bg_color2;
uniform float bg_type;          // 0 solid, 1 radial, 2 linear
uniform float2 bg_dir;

// Pattern Border "Round Source Corners"
uniform float2 src_size;
uniform float4 src_radii;

uniform texture2d cell_texture;
uniform texture2d image;

sampler_state TileSampler {
	Filter   = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

struct InstVert {
	float4 pos    : POSITION;
	float2 local  : TEXCOORD0; // px in the shape's own frame
	float2 screen : TEXCOORD1; // canvas px
	float4 color  : TEXCOORD2; // linear rgb, a = instance alpha
};

VertData VSDefault(VertData v_in)
{
	VertData v_out;
	v_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	v_out.uv  = v_in.uv;
	return v_out;
}

// ---------------------------------------------------------------- helpers

// Floor modulo, exact for integer values below 2^24 even when the
// division rounds.
float wrapf(float x, float m)
{
	float r = x - floor(x / m) * m;
	if (r < 0.0)
		r += m;
	if (r >= m)
		r -= m;
	return r;
}

// Dave Hoskins' sine-free hash12 (see clat_hash).
float hash11(float2 p, float seed)
{
	p += seed * float2(0.7548777, 0.5698403);
	float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
	p3 += dot(p3, float3(p3.y, p3.z, p3.x) + 33.33);
	return frac((p3.x + p3.y) * p3.z);
}

float2 hash22(float2 p, float seed)
{
	return float2(hash11(p, seed), hash11(p + 17.0, seed + 1.7));
}

float2 rotate2(float2 p, float a)
{
	float c = cos(a);
	float s = sin(a);
	return float2(c * p.x - s * p.y, s * p.x + c * p.y);
}

float srgb_to_linear(float c)
{
	return (c <= 0.04045) ? (c / 12.92) : pow((c + 0.055) / 1.055, 2.4);
}

// ---------------------------------------------------------------- shapes

float sd_circle(float2 p, float r)
{
	return length(p) - r;
}

float sd_box(float2 p, float2 b)
{
	float2 q = abs(p) - b;
	return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0);
}

float sd_cross(float2 p, float arm_len, float arm_thick)
{
	float h = sd_box(p, float2(arm_len, arm_thick));
	float v = sd_box(p, float2(arm_thick, arm_len));
	return min(h, v);
}

float sd_polygon(float2 p, float r, float n)
{
	float fn = max(floor(n + 0.5), 3.0);
	float ang = atan2(p.x, p.y);
	float sector = 6.2831853 / fn;
	float idx = floor(ang / sector + 0.5);
	float a = idx * sector;
	float ca = cos(a);
	float sa = sin(a);
	float2 pr = float2(ca * p.x - sa * p.y, sa * p.x + ca * p.y);
	return pr.y - r * cos(sector * 0.5);
}

// Odd side counts are vertically asymmetric around the circumcenter (the
// top vertex reaches r, the flat bottom edge only the apothem), so they are
// re-centered on their bounding box to sit level with the other shapes.
float sd_polygon_centered(float2 p, float r, float n)
{
	float fn = max(floor(n + 0.5), 3.0);
	float yc = 0.0;
	if (frac(fn * 0.5) > 0.25)
		yc = (r * cos(3.14159265 / fn) - r) * 0.5;
	return sd_polygon(float2(p.x, p.y + yc), r, fn);
}

float sd_squircle(float2 p, float r)
{
	float2 ap = abs(p);
	float ax = max(ap.x, 1.0e-5);
	float ay = max(ap.y, 1.0e-5);
	float k = pow(pow(ax, 4.0) + pow(ay, 4.0), 0.25);
	return k - r;
}

// Exact 5-point star, tip up (y is flipped for screen space). The inner
// vertices sit at 0.45 of the outer radius.
float sd_star5(float2 p, float r)
{
	float2 k1 = float2(0.809016994, -0.587785252);
	float2 k2 = float2(-k1.x, k1.y);
	float rf = 0.45;
	float2 q = float2(abs(p.x), -p.y);
	q -= 2.0 * max(dot(k1, q), 0.0) * k1;
	q -= 2.0 * max(dot(k2, q), 0.0) * k2;
	q.x = abs(q.x);
	q.y -= r;
	float2 ba = rf * float2(-k1.y, k1.x) - float2(0.0, 1.0);
	float h = clamp(dot(q, ba) / dot(ba, ba), 0.0, r);
	return length(q - ba * h) * sign(q.y * ba.x - q.x * ba.y);
}

float dot2(float2 v)
{
	return dot(v, v);
}

// iq's unit heart spans y in [0..1] with the tip at the origin; y is flipped
// for screen space and shifted so the shape is centered.
float sd_heart(float2 p, float sz)
{
	float s = max(sz, 1.0e-4) * 0.85;
	float2 q = float2(abs(p.x), -p.y) / s + float2(0.0, 0.5);
	float d;
	if (q.y + q.x > 1.0)
		d = sqrt(dot2(q - float2(0.25, 0.75))) - 0.35355339;
	else
		d = sqrt(min(dot2(q - float2(0.0, 1.0)), dot2(q - 0.5 * max(q.x + q.y, 0.0)))) * sign(q.x - q.y);
	return d * s;
}

float shape_sdf(float2 p)
{
	float r = shape_size * 0.5;
	if (shape_kind < 0.5) return sd_circle(p, r);
	if (shape_kind < 1.5) return sd_cross(p, r, max(stroke_thickness, 0.05) * shape_size * 0.5);
	if (shape_kind < 2.5) return sd_box(p, float2(r, r));
	if (shape_kind < 3.5) return sd_polygon_centered(p, r, polygon_sides);
	if (shape_kind < 4.5) return sd_squircle(p, r);
	if (shape_kind < 5.5) return abs(p.y) - r;
	if (shape_kind < 6.5) return abs(p.x) - r;
	if (shape_kind < 7.5) return sd_star5(p, r);
	return sd_heart(p, shape_size);
}

// ----------------------------------------------------------------- masks

float vignette_mask(float2 px)
{
	if (vignette_enabled < 0.5)
		return 1.0;
	float2 d = px - vignette_center;
	float r = max(vignette_size_px, 1.0);
	float v;
	if (vignette_shape < 0.5) {
		v = length(d) / r;
	} else if (vignette_shape < 1.5) {
		float2 dir = float2(cos(vignette_direction), sin(vignette_direction));
		v = (dot(d, dir) / r) * 0.5 + 0.5;
	} else {
		float2 rd = rotate2(d, -vignette_direction);
		if (vignette_shape < 2.5)
			v = max(abs(rd.x), abs(rd.y)) / r;
		else
			v = sd_polygon(rd, r, vignette_polygon_sides) / r + 1.0;
	}
	float soft = max(vignette_softness, 0.001);
	float a = 1.0 - smoothstep(1.0 - soft, 1.0, v);
	if (vignette_inverted > 0.5)
		a = 1.0 - a;
	return saturate(a);
}

// Rounded box with its own radius per corner (tl, tr, br, bl), y down.
float sd_rbox(float2 p, float2 b, float4 r)
{
	float rr = r.z;
	if (p.x < 0.0) {
		if (p.y < 0.0)
			rr = r.x;
		else
			rr = r.w;
	} else if (p.y < 0.0) {
		rr = r.y;
	}
	float2 q = abs(p) - b + rr;
	return min(max(q.x, q.y), 0.0) + length(max(q, 0.0)) - rr;
}

float border_outer_sd(float2 px)
{
	float2 half_c = canvas_size * 0.5;
	float rc = border_radius;
	return sd_rbox(px - half_c, half_c, float4(rc, rc, rc, rc));
}

float border_inner_sd(float2 px)
{
	float2 lo = border_widths.xy;
	float2 hi = max(canvas_size - border_widths.zw, lo);
	float2 b = (hi - lo) * 0.5;
	float4 r = min(border_inner_radii, min(b.x, b.y));
	return sd_rbox(px - (lo + hi) * 0.5, b, r);
}

// Coverage of the frame band: inside the outer edge and outside the inner
// edge, fading in over border_softness px from the inner edge.
float border_band_mask(float2 px)
{
	float outer = 1.0 - smoothstep(-0.5, 0.5, border_outer_sd(px));
	float inner = smoothstep(-0.5, 0.5 + border_softness, border_inner_sd(px));
	return outer * inner;
}

float border_shape_mask(float2 px)
{
	if (border_active < 0.5)
		return 1.0;
	if (border_clip > 0.5)
		return border_band_mask(px);
	return 1.0 - smoothstep(-0.5, 0.5, border_outer_sd(px));
}

float masks(float2 px)
{
	return vignette_mask(px) * border_shape_mask(px);
}

// ------------------------------------------------------------- placement

// Whether this item draws the cell; in Step and Repeat and Grid layouts
// every cell belongs to exactly one item.
bool owns_cell(float2 cid)
{
	if (layout_mode < 0.5)
		return true;
	float n = max(step_count, 1.0);
	if (layout_mode > 1.5 && grid_random > 0.5) {
		// The seed is shared by every item's pass, so all passes agree.
		float pick = min(floor(hash11(cid + 0.5, 31.7) * n), n - 1.0);
		return abs(pick - step_index) < 0.5;
	}
	return abs(wrapf(cid.x, n) - step_index) < 0.5;
}

// Two counter-rotating circles per instance, each with its own phase and
// rate: the path stays inside a disc and favors no direction. Rates are
// quantized to 1/64 so wander_time can wrap at 64 * 2 pi without a jump.
float2 wander_offset(float2 cid, float cs)
{
	if (wander_amt <= 0.0)
		return float2(0.0, 0.0);
	float2 ph = hash22(cid + 0.5, item_seed) * 6.2831853;
	float2 rate = (32.0 + floor(hash22(cid + 17.9, item_seed + 4.7) * 65.0)) / 64.0;
	float a1 = wander_time * rate.x + ph.x;
	float a2 = ph.y - wander_time * rate.y;
	return float2(cos(a1) + cos(a2), sin(a1) + sin(a2)) * (wander_amt * cs * 0.5);
}

float twinkle_alpha(float2 cid)
{
	if (twinkle_amount <= 0.001)
		return 1.0;
	if (hash11(cid + 3.7, item_seed + 5.13) > twinkle_amount)
		return 1.0;
	float ph = hash11(cid + 11.9, item_seed + 7.77) * 6.2831853;
	float rate = (48.0 + floor(hash11(cid + 27.3, item_seed + 2.19) * 33.0)) / 64.0;
	return sin(twinkle_phase * rate * 6.2831853 + ph) * 0.5 + 0.5;
}

float3 cell_rgb(float2 cid)
{
	if (color_variation < 0.5)
		return shape_color.rgb;
	float pick = floor(hash11(cid + 53.1, item_seed + 9.37) * 3.0);
	if (pick < 0.5)
		return shape_color.rgb;
	if (pick < 1.5)
		return color_b.rgb;
	return color_c.rgb;
}

float auto_rot_angle(float2 cid)
{
	if (auto_rot_active < 0.5)
		return 0.0;
	return hash11(cid + 41.3, auto_rot_seed + item_seed + 6.29) * 6.2831853 + auto_rot_phase;
}

// Turn toward the next side over the half spacing either side of a sharp
// corner, so the corner shape points diagonally.
float border_side_angle(float base, float v, float n, float r_prev, float r_next)
{
	float a = base;
	if (r_prev < 0.5 && v < 0.5)
		a -= (0.5 - v) * 1.5707963;
	if (r_next < 0.5 && v > n - 0.5)
		a += (v - n + 0.5) * 1.5707963;
	return a;
}

// Point at path parameter u on the current border row, its clockwise
// heading, and the spacing of the shapes on that segment (mirrors
// clat_border_point).
float2 border_point(float u, out float ang, out float spacing)
{
	float x0 = row_box.x;
	float y0 = row_box.y;
	float x1 = row_box.z;
	float y1 = row_box.w;
	float4 r = row_rad;
	float u0 = 0.0;
	ang = 0.0;
	spacing = cell_size;

	if (u < u0 + row_ns.x) {
		float v = u - u0;
		ang = border_side_angle(0.0, v, row_ns.x, r.x, r.y);
		spacing = (x1 - x0 - r.x - r.y) / row_ns.x;
		return lerp(float2(x0 + r.x, y0), float2(x1 - r.y, y0), v / row_ns.x);
	}
	u0 += row_ns.x;
	if (u < u0 + row_na.x) {
		float a = -1.5707963 + (u - u0) / row_na.x * 1.5707963;
		ang = a + 1.5707963;
		spacing = r.y * 1.5707963 / row_na.x;
		return float2(x1 - r.y, y0 + r.y) + r.y * float2(cos(a), sin(a));
	}
	u0 += row_na.x;
	if (u < u0 + row_ns.y) {
		float v = u - u0;
		ang = border_side_angle(1.5707963, v, row_ns.y, r.y, r.z);
		spacing = (y1 - y0 - r.y - r.z) / row_ns.y;
		return lerp(float2(x1, y0 + r.y), float2(x1, y1 - r.z), v / row_ns.y);
	}
	u0 += row_ns.y;
	if (u < u0 + row_na.y) {
		float a = (u - u0) / row_na.y * 1.5707963;
		ang = a + 1.5707963;
		spacing = r.z * 1.5707963 / row_na.y;
		return float2(x1 - r.z, y1 - r.z) + r.z * float2(cos(a), sin(a));
	}
	u0 += row_na.y;
	if (u < u0 + row_ns.z) {
		float v = u - u0;
		ang = border_side_angle(3.1415927, v, row_ns.z, r.z, r.w);
		spacing = (x1 - x0 - r.z - r.w) / row_ns.z;
		return lerp(float2(x1 - r.z, y1), float2(x0 + r.w, y1), v / row_ns.z);
	}
	u0 += row_ns.z;
	if (u < u0 + row_na.z) {
		float a = 1.5707963 + (u - u0) / row_na.z * 1.5707963;
		ang = a + 1.5707963;
		spacing = r.w * 1.5707963 / row_na.z;
		return float2(x0 + r.w, y1 - r.w) + r.w * float2(cos(a), sin(a));
	}
	u0 += row_na.z;
	if (u < u0 + row_ns.w) {
		float v = u - u0;
		ang = border_side_angle(4.7123890, v, row_ns.w, r.w, r.x);
		spacing = (y1 - y0 - r.w - r.x) / row_ns.w;
		return lerp(float2(x0, y1 - r.w), float2(x0, y0 + r.x), v / row_ns.w);
	}
	u0 += row_ns.w;
	float na = max(row_na.w, 1.0);
	float a = 3.1415927 + (u - u0) / na * 1.5707963;
	ang = a + 1.5707963;
	spacing = r.x * 1.5707963 / na;
	return float2(x0 + r.x, y0 + r.x) + r.x * float2(cos(a), sin(a));
}

InstVert VSInstance(uint id : VERTEXID)
{
	InstVert v_out;

	// Six vertices per instance: triangles (0, 1, 2) and (2, 1, 3) of the
	// quad's corners.
	float fid = float(id);
	float q = floor(fid / 6.0);
	float k = fid - q * 6.0;
	if (k < 0.0) {
		q -= 1.0;
		k += 6.0;
	} else if (k >= 6.0) {
		q += 1.0;
		k -= 6.0;
	}
	float vi = (k < 2.5) ? k : ((k < 3.5) ? 2.0 : ((k < 4.5) ? 1.0 : 3.0));
	float2 corner = float2(wrapf(vi, 2.0) * 2.0 - 1.0, floor(vi * 0.5 + 0.25) * 2.0 - 1.0);

	float cs = max(cell_size, 1.0);
	float2 cid;
	float2 center;
	float heading = 0.0;
	float spacing = cs;
	bool valid = true;

	if (ring_mode > 0.5) {
		// A line that follows the frame is one continuous ring per row:
		// a single quad over the canvas, shaded by distance to the path.
		cid = float2(0.0, row_index);
		center = canvas_size * 0.5;
	} else if (border_mode > 0.5) {
		cid = float2(q, row_index);
		center = border_point(wrapf(q + row_phase, max(row_total, 1.0)), heading, spacing);
		float2 tng = float2(cos(heading), sin(heading));
		center += float2(-tng.y, tng.x) * offset_inward;
		center += wander_offset(cid, cs);
		if (border_align < 0.5)
			heading = 0.0;
	} else {
		float j = floor(q / col_count);
		float ci = q - j * col_count;
		if (ci < 0.0) {
			j -= 1.0;
			ci += col_count;
		} else if (ci >= col_count) {
			j += 1.0;
			ci -= col_count;
		}
		float rl = row_first + j;
		float row_id = wrapf(rl - row_wrap, 4096.0);
		bool odd = wrapf(row_id, 2.0) > 0.5;

		// Whole cells and px this row has scrolled: exact integer
		// arithmetic in float (every product stays below 2^24).
		float rq = 64.0;
		if (drift_speed_amt > 0.0) {
			float s = (hash11(float2(row_id, 7.0), drift_speed_seed) - 0.5) * 2.0 * drift_speed_amt;
			rq = clamp(floor(64.0 * (1.0 + s) + 0.5), 0.0, 128.0);
		}
		float p = wrapf(col_cells * rq, 64.0 * col_period);
		float whole = floor(p / 64.0);
		float sub = (p - whole * 64.0) / 64.0 * cs + col_frac * rq / 64.0;
		if (alt_lines > 0.5 && odd) {
			whole = wrapf(-whole, col_period);
			sub = -sub;
		}
		float brick_px = (brick > 0.5 && odd) ? cs * 0.5 : 0.0;
		float col_local = ceil((along_min - sub - brick_px) / cs) + ci;
		cid = float2(wrapf(col_local - whole, col_period), row_id);

		float2 lat = float2(col_local * cs + sub + brick_px, rl * cs + perp_frac);
		lat += wander_offset(cid, cs);
		float2 perp = float2(-lattice_dir.y, lattice_dir.x);
		center = origin + lattice_dir * lat.x + perp * lat.y;
		heading = atan2(lattice_dir.y, lattice_dir.x);
		valid = owns_cell(cid);
	}

	float alpha = shape_color.a * twinkle_alpha(cid);
	if (alpha < 0.002)
		valid = false;

	float2 half_ext = quad_half;
	if (line_axis > 1.5)
		half_ext.y = spacing * 0.5;
	else if (line_axis > 0.5)
		half_ext.x = spacing * 0.5;
	float2 local = corner * half_ext;
	float2 offs = local;
	if (ring_mode < 0.5)
		offs = rotate2(rotate2(local, -(shape_rotation + auto_rot_angle(cid))), heading);
	float2 screen = center + offs;

	v_out.pos = valid ? mul(float4(screen, 0.0, 1.0), ViewProj) : float4(2.0, 2.0, 2.0, 1.0);
	v_out.local = local;
	v_out.screen = screen;
	v_out.color = float4(cell_rgb(cid), alpha);
	return v_out;
}

// ----------------------------------------------------------- pixel shaders

// Distance to the current border row's path, moved offset_inward px inside.
float ring_sdf(float2 px)
{
	float o = offset_inward;
	float2 lo = row_box.xy + o;
	float2 hi = max(row_box.zw - o, lo);
	float2 b = (hi - lo) * 0.5;
	float4 r = min(max(row_rad - o, 0.0), min(b.x, b.y));
	return abs(sd_rbox(px - (lo + hi) * 0.5, b, r)) - shape_size * 0.5;
}

float4 PSShape(InstVert v_in) : TARGET
{
	float d = (ring_mode > 0.5) ? ring_sdf(v_in.screen) : shape_sdf(v_in.local);
	if (outline_only > 0.5)
		d = abs(d) - max(stroke_thickness, 0.001) * shape_size * 0.5;
	float edge = clamp(fwidth(d), 0.5, 2.0) * 0.75;
	float a = (1.0 - smoothstep(-edge, edge, d)) * v_in.color.a * masks(v_in.screen);
	return float4(v_in.color.rgb * a, a);
}

float4 PSImage(InstVert v_in) : TARGET
{
	float2 uv = v_in.local / (quad_half * 2.0) + 0.5;
	float4 tex = cell_texture.Sample(TileSampler, uv);
	if (image_color_mode > 1.5)
		tex.rgb = v_in.color.rgb * tex.a;
	else if (image_color_mode > 0.5)
		tex.rgb *= v_in.color.rgb;
	return tex * (v_in.color.a * masks(v_in.screen));
}

float4 PSBackground(VertData v_in) : TARGET
{
	float2 px = v_in.uv * canvas_size;
	float2 half_canvas = canvas_size * 0.5;
	float4 c = bg_color;
	if (bg_type > 0.5) {
		float t;
		if (bg_type < 1.5) {
			// Radial: center of the canvas out to its corners.
			t = length(px - half_canvas) / max(length(half_canvas), 1.0);
		} else {
			// Linear: spans the canvas exactly along bg_dir.
			float extent = abs(bg_dir.x) * half_canvas.x + abs(bg_dir.y) * half_canvas.y;
			t = dot(px - half_canvas, bg_dir) / max(2.0 * extent, 1.0) + 0.5;
		}
		c = lerp(bg_color, bg_color2, saturate(t));
		// Dark gradients band visibly in 8-bit output; one code of
		// noise (in the encoded space the output is quantized in)
		// hides it.
		c.rgb += (hash11(floor(px), 0.0) - 0.5) / 255.0;
	}
	float3 lin = float3(srgb_to_linear(saturate(c.r)), srgb_to_linear(saturate(c.g)), srgb_to_linear(saturate(c.b)));
	float a = c.a;
	if (border_active > 0.5)
		a *= border_band_mask(px);
	return float4(lin * a, a);
}

// Draws the filtered source clipped to a rounded box covering it.
float4 PSSourceRounded(VertData v_in) : TARGET
{
	float4 c = image.Sample(TileSampler, v_in.uv);
	float2 half_s = src_size * 0.5;
	float4 r = min(src_radii, min(half_s.x, half_s.y));
	float d = sd_rbox(v_in.uv * src_size - half_s, half_s, r);
	return c * (1.0 - smoothstep(-0.5, 0.5, d));
}

technique DrawBackground
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSBackground(v_in);
	}
}

technique DrawShape
{
	pass
	{
		vertex_shader = VSInstance(id);
		pixel_shader  = PSShape(v_in);
	}
}

technique DrawImage
{
	pass
	{
		vertex_shader = VSInstance(id);
		pixel_shader  = PSImage(v_in);
	}
}

technique DrawSourceRounded
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSSourceRounded(v_in);
	}
}
